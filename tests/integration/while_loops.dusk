@compiler_test(success, 10)
@compiler_test(success, 1000)
fn test_while_loop(limit: i32) {
    i := 0
    while i < limit {
        i += 1
    }

    core.assert(i == limit)
}

@compiler_test(success, 2)
@compiler_test(success, 30)
fn test_while_loop(limit: i32) {
    i := 0
    counter := 1
    while i < limit {
        counter *= 2
        i += 1
    }

    core.assert(counter == 1 << limit)
}
