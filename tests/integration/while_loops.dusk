@compiler_test(success, 10)
@compiler_test(success, 1000)
fn test_while_loop(limit: i32) {
    i := 0
    while i < limit {
        i += 1
    }

    core.assert(i == limit)
}

@compiler_test(success, 2)
@compiler_test(success, 30)
fn test_while_loop(limit: i32) {
    i := 0
    counter := 1
    while i < limit {
        counter *= 2
        i += 1
    }

    core.assert(counter == 1 << limit)
}

// These tests previously crashed the compiler during MIR generation
@compiler_test(success, 0)
fn crasher1(n: u32): u32 {
    while n > 0 { print("x\n") }
    n
}

@compiler_test(success, 0)
fn crasher2(n: u32): u32 {
    if true {}
    while n > 0 { print("x\n") }
    n
}
