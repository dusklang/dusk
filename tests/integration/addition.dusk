@compiler_test(failure, 1, 2, 4)
@compiler_test(success, 1, 2, 3)
@compiler_test(success, 7, 10, 17)
fn test_add_i32(a: i32, b: i32, result: i32) {
    core.assert(a + b == result)
}

@compiler_test(failure, 1, 2, 4)
@compiler_test(success, 1, 2, 3)
@compiler_test(success, 7, 10, 17)
fn test_add_u32(a: u32, b: u32, result: u32) {
    core.assert(a + b == result)
}

@compiler_test(failure, 1.0, 2.0, 4.0)
@compiler_test(success, 1.0, 2.0, 3.0)
@compiler_test(success, 7.0, 10.0, 17.0)
fn test_add_f64(a: f64, b: f64, result: f64) {
    core.assert(a + b == result)
}

// These casts should not be necessary once typechecking of compiler_test arguments is complete
@compiler_test(failure, 1.0 as f32, 2.0 as f32, 4.0 as f32)
@compiler_test(success, 1.0 as f32, 2.0 as f32, 3.0 as f32)
@compiler_test(success, 7.0 as f32, 10.0 as f32, 17.0 as f32)
fn test_add_f32(a: f32, b: f32, result: f32) {
    core.assert(a + b == result)
}
