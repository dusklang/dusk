@compiler_test(failure, 1, 2, 4)
@compiler_test(success, 122, 5, 127)
@compiler_test(success, 7, 10, 17)
fn test_add_i8(a: i8, b: i8, result: i8) {
    core.assert(a + b == result)
}

@compiler_test(failure, 1, 2, 4)
@compiler_test(success, 32762, 5, 32767)
@compiler_test(success, 7, 10, 17)
fn test_add_i16(a: i16, b: i16, result: i16) {
    core.assert(a + b == result)
}

